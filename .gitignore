# NEVER commit secrets or real local env files. Secrets come from OpenBao at
# runtime (see examples/envrc.example), not from files in this repo.
.env
.env.*
*.local
.envrc
!examples/*.example
.direnv/

# Claude Code local settings (machine-specific overrides; not portable)
.claude/settings.local.json

# Agent worktrees. The agent rules mandate worktree isolation for every
# code-change task, and Claude Code puts them here — so the path must be
# invisible to git, or every session offers to commit its own checkout.
# `.worktrees/` is the same thing under a different harness's convention;
# both must be ignored or the workbench never reads clean.
.claude/worktrees/
.worktrees/

# chezmoi local state / OS cruft
.DS_Store
chezmoistate.boltdb

# Docusaurus build output (the pages workflow builds this; never commit it)
/dist/
