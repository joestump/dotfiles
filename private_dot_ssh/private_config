Host github.com
  Hostname ssh.github.com
  Port 443
  User git
  ServerAliveInterval 600
  TCPKeepAlive yes
  IPQoS=throughput
  # github.com is routed to ssh.github.com:443 (above), whose host key lives
  # under the [ssh.github.com]:443 identity in known_hosts. On a fresh box with
  # no known_hosts yet, strict checking makes the first clone fail with "No
  # ED25519 host key is known". accept-new pins the key on first contact (and
  # rejects any later change), matching how the 192.168.100.* blocks below work.
  StrictHostKeyChecking accept-new

# ie02 on dagda (DUB) — reachable only via ProxyJump through the hypervisor
Host 192.168.100.213
    HostName 192.168.100.213
    User joestump
    ProxyJump root@dagda.stump.rocks
    IdentityFile ~/.ssh/id_ansible
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

Host 192.168.100.210
    HostName 192.168.100.210
    User joestump
    ProxyJump root@dagda.stump.rocks
    IdentityFile ~/.ssh/id_ansible
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new

Host 192.168.100.220
    HostName 192.168.100.220
    User joestump
    ProxyJump root@dagda.stump.rocks
