# shellcheck shell=bash
# Shared "send a Signal note-to-self from a non-interactive script" helper — for
# anything running under launchd/systemd --user that needs to alert Joe without
# going through Claude. Used by vault-agent-stale.sh (dead-auth alert) and
# czu-run.sh (scheduled-sync failure alert). Source this, then call `notify "msg"`.
#
# Tries the warm signal-cli daemon first (JSON-RPC on 127.0.0.1:7583 — fast, no
# cold JVM start), falls back to a cold signal-cli send, then to syslog as a last
# resort so the failure is at least discoverable.
# The alert recipient is the HUMAN the agents serve, resolved from the
# OpenBao-provisioned runtime env (secret/users/<whoami>/signal →
# SIGNAL_MCP_OPERATOR) — no number is baked into this file. Callers (czu,
# vault-agent-stale) source secrets-static.env before running; if the var is
# genuinely absent (unprovisioned box) notify() degrades to syslog below.
SIGNAL_NUMBER="${SIGNAL_MCP_OPERATOR:-}"

_signal_have() { command -v "$1" >/dev/null 2>&1; }

# Uses python3 for a BOUNDED socket exchange — raw `nc` half-closes and hangs on
# BSD/macOS because the daemon keeps the connection open. Returns 0 only on a
# JSON-RPC result.
_signal_send_via_daemon() {
  _signal_have python3 || return 1
  python3 - "$SIGNAL_NUMBER" "$1" <<'PY'
import socket, json, sys
num, msg = sys.argv[1], sys.argv[2]
try:
    s = socket.create_connection(("127.0.0.1", 7583), timeout=5)
    s.settimeout(8)
    s.sendall((json.dumps({"jsonrpc":"2.0","method":"send",
        "params":{"recipient":[num],"message":msg},"id":1})+"\n").encode())
    buf = b""
    while b"\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
    s.close()
    for line in buf.decode(errors="replace").splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("id") == 1:
            sys.exit(0 if "result" in d else 1)
    sys.exit(1)
except Exception:
    sys.exit(1)
PY
}

# Run a command under a wall-clock budget, portably. macOS ships no `timeout`
# (that's GNU coreutils, and `gtimeout` only exists if you brewed it), so fall
# back to a watchdog: run in the background, kill it if it outlives the budget.
# Works under both bash and zsh, which both source this file.
_signal_bounded() {
  local secs="$1"; shift
  if _signal_have timeout;  then timeout  "$secs" "$@"; return $?; fi
  if _signal_have gtimeout; then gtimeout "$secs" "$@"; return $?; fi
  local pid wd rc
  "$@" & pid=$!
  ( sleep "$secs"; kill -TERM "$pid" 2>/dev/null; sleep 2; kill -KILL "$pid" 2>/dev/null ) 2>/dev/null & wd=$!
  wait "$pid" 2>/dev/null; rc=$?
  kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
  return "$rc"
}

notify() {
  local msg="$1"
  # No operator in the env (unprovisioned box) → there is nobody to text.
  # Syslog instead of failing, so the CALLER's exit code stays about its own work.
  if [ -z "$SIGNAL_NUMBER" ]; then
    logger -t signal-notify -- "SIGNAL_MCP_OPERATOR unset; alert dropped: $msg" 2>/dev/null
    return 0
  fi
  # 1) warm signal-cli daemon — fast, no cold JVM.
  _signal_send_via_daemon "$msg" && return 0
  # 2) cold signal-cli send (note-to-self) — reliable where the daemon isn't up.
  #
  # MUST be bounded. signal-cli takes an exclusive lock on its data dir, and when
  # something else holds it (a wedged daemon, a second LaunchAgent, another cold
  # invocation) it does not fail — it prints "Config file is in use by another
  # instance, waiting…" and blocks FOREVER. With this call's output sent to
  # /dev/null that is an invisible, unbounded hang inside whatever was merely
  # trying to send a notification: it wedged `czu` right after the Vault Agent
  # reload, and the headless 6-hourly czu along with it (whose stuck process then
  # held chezmoi's state lock, so the NEXT run failed too). A notification must
  # never be able to outlive the thing it is reporting on. 25s is a generous cold
  # JVM start; past that, fall through to the log.
  if _signal_have signal-cli; then
    _signal_bounded 25 signal-cli -a "$SIGNAL_NUMBER" send -m "$msg" "$SIGNAL_NUMBER" >/dev/null 2>&1 && return 0
  fi
  # 3) last resort so it is at least discoverable in the system log.
  _signal_have logger && logger -t signal-notify "$msg"
  return 1
}
