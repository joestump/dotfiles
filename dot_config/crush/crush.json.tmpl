{
  "$schema": "https://charm.land/crush.json",
{{- /* Every provider renders UNCONDITIONALLY, and every credential is emitted as a
       "$VAR" reference that Crush expands at runtime — never a literal value. Do
       not reintroduce apply-time `if env` gates around these blocks. (Written
       without the surrounding braces on purpose — test/czu-run-env.bats greps
       this file for the real thing.)

       Why: a gate is evaluated at APPLY time, but the secret is only needed at
       CRUSH RUN time, so the gate buys nothing (no key lands in this file either
       way) while creating a silent, recurring outage. Any `chezmoi apply` from a
       shell without the Vault-rendered environment — an agent's non-interactive
       Bash, a launchd/systemd timer, a plain `chezmoi apply` typed in a subshell —
       saw every gate as false and wrote `"providers": {}`. That is valid JSON and
       exits 0, so nothing failed loudly; Crush simply refused to start with
       "default providers are disabled and there are no custom providers are
       configured", and the usual next step was pasting a key into Crush's TUI,
       persisting a plaintext secret outside OpenBao. czu-run.zsh sources the
       secrets for its own apply, but it cannot defend the bare-apply path — and
       ~/.claude/hooks/chezmoi-edit-guard.sh instructs every agent that edits this
       repo to run exactly that. Rendering unconditionally removes the failure mode
       at the source instead of chasing each caller.

       Trade-off, accepted deliberately: on a machine that genuinely lacks a key,
       the provider is listed and fails when selected. One dead entry beats zero
       providers and an unusable Crush.

       Credential origins (all from OpenBao at secret/users/<you>/…, rendered into
       ~/.config/vault/secrets-static.env by Vault Agent; OPENAI_DIRECT_API_KEY is
       DERIVED in ~/.oh-my-zsh/custom/env.zsh from the raw OPENAI_API_KEY before the
       LiteLLM gateway shadows it):
         OPENAI_DIRECT_API_KEY  openai
         LITELLM_API_KEY        litellm (StumpCloud gateway)
         GEMINI_API_KEY         gemini (Google AI Studio direct)
         ZAI_API_TOKEN          zai (Z.ai GLM Coding Plan)
         HYPER_API_KEY          hyper (charm.land)

       No default model is pinned — Crush persists the user's pick in its own data
       config (~/.local/share/crush/crush.json), which chezmoi does not manage. */ -}}
  "providers": {
    "openai": {
      "type": "openai",
      "name": "OpenAI",
      "base_url": "https://api.openai.com/v1",
      "api_key": "$OPENAI_DIRECT_API_KEY",
      "discover_models": true
    },
    "litellm": {
      "type": "litellm",
      "name": "LiteLLM (StumpCloud)",
      "base_url": "{{ .litellmUrl }}",
      "api_key": "$LITELLM_API_KEY",
      "discover_models": true
    },
    "gemini": {
      "type": "openai-compat",
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "api_key": "$GEMINI_API_KEY",
      "discover_models": true
    },
    "zai": {
      "type": "openai-compat",
      "name": "Z.ai (GLM Coding Plan)",
      "base_url": "$ZAI_BASE_URL",
      "api_key": "$ZAI_API_TOKEN",
      "discover_models": true,
      {{- /* glm-5.3 is served by the Z.ai coding plan but missing from its
             /v4/models discovery list (requests for glm-5.2 are answered by
             glm-5.3), so it needs this one manual pin to be selectable.
             Unpriced: the coding plan is subscription-metered, not per-token. */ -}}
      "models": [
        {
          "id": "glm-5.3",
          "name": "GLM-5.3"
        }
      ]
    },
    "hyper": {
      "type": "openai-compat",
      "name": "Hyper (charm.land)",
      "base_url": "https://hyper.charm.land/v1",
      "api_key": "$HYPER_API_KEY",
      "discover_models": true
    }
  },
{{- /* Semantic search — an on-demand vector index over the working repo, backing
       the fork's `semantic_index` / `semantic_search` tools (crush#278). Both
       tools are registered ONLY when this block is present and the sqlite-vec
       store initialises; without it Crush has grep and nothing else for
       "where is retry decided?"-shaped questions.

       Points at the StumpCloud LiteLLM gateway rather than the embedding
       service directly. bge-m3 is served by text-embeddings-inference on the
       ie01 RTX A2000 Ada and IS reachable at https://bge-m3.stump.wtf — but
       that vhost sits behind oauth2-proxy, which answers a Bearer token with a
       login redirect, and Crush speaks plain OpenAI auth. LiteLLM already
       fronts the same container over its own API key (model `bge-m3` →
       hosted_vllm/bge-m3 at http://bge-m3:8000/v1, in-cluster, no proxy), so
       the gateway is the only path that authenticates. Same $LITELLM_API_KEY
       as the litellm provider above, and the same unconditional-render rule:
       a "$VAR" reference, never a literal, never an `if env` gate.

       dimension 1024 is NOT a preference — it is what BAAI/bge-m3 emits, and
       TEI ignores OpenAI's `dimensions` truncation parameter, so the vector
       length is fixed by the model. Crush's default of 768 would mismatch every
       insert. The value is baked into the vec0 table at creation: changing it
       later fails loudly and needs a reindex (drop `chunks` + `chunk_vectors`,
       re-run semantic_index), so treat it as tied to the model choice.

       Cost note: embeddings run on Joe's own GPU, so indexing a large repo is
       free apart from wall time. Indexing stays on demand (there is no apply-
       time or session-start trigger here) — the agent runs semantic_index when
       it wants the index, and re-runs are incremental. */}}
  "embeddings": {
    "base_url": "{{ .litellmUrl }}",
    "api_key": "$LITELLM_API_KEY",
    "model": "bge-m3",
    "dimension": 1024
  },
  "lsp": {
    "go": {
      "command": "gopls",
      "enabled": true
    },
    "python": {
      "command": "pyright",
      "args": ["--stdio"],
      "enabled": true
    },
    "ansible": {
      "command": "ansible-language-server",
      "args": ["--stdio"],
      "enabled": true
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "enabled": true
    },
    "markdown": {
      "command": "marksman",
      "enabled": true
    },
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "enabled": true
    },
    "json": {
      "command": "vscode-json-language-server",
      "args": ["--stdio"],
      "enabled": true
    }
  },
  "mcp": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{{ .chezmoi.homeDir }}/src"
      ],
      "timeout": 60,
      "disabled": false
    },
    "gitea": {
      "type": "stdio",
      "command": "go",
      "args": ["run", "gitea.com/gitea/gitea-mcp@latest", "-t", "stdio"],
      "env": {
        "GITEA_HOST": "{{ .giteaUrl }}",
        "GITEA_ACCESS_TOKEN": "$GITEA_TOKEN"
      },
      "timeout": 120,
      "disabled": false
    },
    "outline": {
      "type": "http",
      "url": "{{ .outlineUrl }}/mcp",
      "headers": {
        "Authorization": "Bearer $OUTLINE_API_TOKEN"
      },
      "timeout": 120,
      "disabled": false
    },
{{- /* NO identity is rendered here — deliberately. signal-mcp resolves
       SIGNAL_MCP_ACCOUNT (the number this box sends AS), SIGNAL_MCP_OPERATOR
       (the human it serves) and SIGNAL_MCP_PREFIX from its RUNTIME env, which
       OpenBao provisions per-user (secret/users/<whoami>/signal →
       secrets-static.env; the harness daemon loads the systemd flavor, login
       shells source it via 00-secrets.zsh). Rendering numbers here would bake
       one identity's config into every box; see .chezmoidata.yaml.

       Do NOT add self-referential env entries ("SIGNAL_MCP_X": "$SIGNAL_MCP_X")
       either: crush expands $VAR from ITS OWN environment and appends the result
       to os.Environ() for the child, so a self-mapping reproduces plain
       inheritance when the var is set and pins an EMPTY value when it is not —
       signal-mcp then sees the var set-but-empty instead of unset. It cannot fix
       a thin-env launch; that is fixed at the source (the harness env_file /
       czu-run.zsh sourcing secrets), not here. The gitea block above is not a
       precedent: it REMAPS a name (GITEA_ACCESS_TOKEN ← $GITEA_TOKEN), which
       does real work. */ -}}
    "signal": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "{{ .chezmoi.homeDir }}/src/signal-mcp",
        "signal-mcp",
        "--transport",
        "stdio",
        "--channel"
      ],
{{- if eq .chezmoi.os "darwin" }}
{{- /* Config env is appended AFTER os.Environ() and the last duplicate key wins,
       so this REPLACES the child's PATH — darwin-only on purpose. It exists for
       launchd-spawned crush, whose thin system PATH lacks Homebrew and
       ~/.local/bin, so uv could not resolve its runtime for the child. On Linux
       the inherited PATH is already sane and this mac-shaped override would
       silently clobber it (dropping ~/.local/bin, where this repo installs its
       binaries). */}}
      "env": {
        "PATH": "{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      },
{{- end }}
{{- /* channel_reply is LOAD-BEARING for the crush-signal harness: the fork's
       sendChannelReply is a silent no-op when it is absent (no built-in
       default), so without it a channel turn whose model never calls a send
       tool itself simply drops the reply. Unlike identity, there is no env
       fallback — this wiring only exists in config. */}}
      "channel_reply": {
        "user": { "tool": "send_message_to_user", "target_param": "user_id" },
        "group": { "tool": "send_message_to_group", "target_param": "group_id" }
      },
      "timeout": 60,
      "disabled": false
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "timeout": 120,
      "disabled": false
    },
    "aws-knowledge": {
      "type": "http",
      "url": "https://knowledge-mcp.global.api.aws",
      "timeout": 120,
      "disabled": false
    },
    {{- /* The AWS MCP Server (GA 2026) — the ACCOUNT-facing one, distinct from
           aws-knowledge above, which is public docs only and needs no auth.
           This one reaches real resources, so every request is SigV4-signed by
           the local mcp-proxy-for-aws bridge using the standard boto credential
           chain. Nothing to store here — but note the chain is only populated
           when Crush is started from an INTERACTIVE shell: secrets-aws.env comes
           from 00-secrets.zsh (OMZ custom), and ~/.aws holds a stale key. A
           Crush launched by the harness gets no AWS credentials.
           Pinned: an unpinned uvx resolves to whatever is newest at launch. */}}
    "aws": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws==1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-west-2"
      ],
      "env": {
        "AWS_SHARED_CREDENTIALS_FILE": "{{ .chezmoi.homeDir }}/.config/aws/credentials",
        "AWS_PROFILE": "agent-readonly"
      },
      "timeout": 120,
      "disabled": false
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "timeout": 60,
      "disabled": false
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "timeout": 60,
      "disabled": false
    },
    "cairn": {
      "type": "http",
      "url": "$CAIRN_BASE_URL/mcp",
      "headers": {
        "Authorization": "Bearer $CAIRN_API_TOKEN"
      },
      "timeout": 120,
      "disabled": false
    },
    "switchboard": {
      "type": "http",
      "url": "$SWITCHBOARD_CRUSH_URL",
      "headers": {
        "Authorization": "Bearer $SWITCHBOARD_CRUSH_API_KEY"
      },
      "timeout": 120,
      "disabled": false
    }
{{ if eq .chezmoi.os "darwin" }},
    "msgbrowse": {
      "type": "http",
      "url": "{{ .msgbrowseMcpEndpoint }}",
      "timeout": 120,
      "disabled": false
    }
{{ end }}
  },
  {{- /* Session titles are generated by the "small" model on every prompt,
         so it must be cheap and self-hosted. Qwen3.8-27B rides the
         StumpCloud LiteLLM gateway (no paid tokens), and thinking is
         disabled per-request via provider_options so the title call gets
         clean text instead of a chain of thought. Requires the matching
         fork change (joestump-agent/crush#287) for provider_options to
         reach the title call. */ -}}
  "models": {
    "small": {
      "model": "Qwen3.8-27B",
      "provider": "litellm",
      "provider_options": {
        "extra_body": {
          "chat_template_kwargs": { "enable_thinking": false }
        }
      }
    }
  },
  "options": {
    "disable_default_providers": true,
    "disable_provider_auto_update": true,
    "disable_metrics": true,
{{- /* Crush aborts an LLM request after 60s with no stream data (its
       default request_timeout). Every scheduled sweep runs on the local
       Qwen3.8-27B, whose cold prefill of a full agent session regularly
       takes longer than that — three StumpCloud sweeps died at exactly
       1m0s on 09/05 with "LLM stream received no data for 1m0s". 300s
       gives a slow prefill room to land while still bounding a hung
       provider; sessions against fast cloud models never notice.
       @joestump-agent 09/06/2026 - Raised from crush's 60s default. */}}
    "request_timeout": 300,
{{- /* Allow the commands StumpCloud fleet operations need. The stumpcloud-
       monitor and triage skills are SSH-and-curl shaped, and the default ban
       list hard-blocks both, so every monitoring cycle died at its first
       probe. Subtracts from the exact-command ban list only; package-manager
       argument blocks are untouched, and allowed commands still pass through
       the normal permission gate.
       @joestump-agent 09/04/2026 - Added for fleet ops (stumpcloud-monitor). */}}
    "allowed_commands": [
      "ssh",
      "scp",
      "curl",
      "wget",
      "rsync"
    ],
    "context_paths": [
      "AGENTS.md",
      "CRUSH.md",
      "CLAUDE.md",
      "**/ADR-*.md",
      "**/adr/*.md",
      "**/openapi.yaml",
      "**/openapi.json"
    ],
{{- /* The private claude-personal marketplace is deliberately NOT cloned a second
       time under skills-ext/ like the public repos above it. It is ALREADY cloned
       (credential-guarded) at .config/claude-marketplaces/claude-personal for the
       Claude Code plugin installer, and a second clone of the same private repo
       would mean two sets of Gitea credentials, two refresh timers, and — the real
       problem — two HEADs, so Crush and Claude Code could serve different versions
       of the same skill. Pointing both at one clone keeps them identical. Crush
       tolerates a path that doesn't exist (skills.go ignores os.IsNotExist), so an
       unprovisioned node without the guarded clone still starts clean. */}}
    "skills_paths": [
      "{{ .chezmoi.homeDir }}/.config/crush/skills",
      "{{ .chezmoi.homeDir }}/.config/crush/skills-ext/claude-skills",
      "{{ .chezmoi.homeDir }}/.config/crush/skills-ext/claude-plugin-sdd/skills",
      "{{ .chezmoi.homeDir }}/.config/crush/skills-ext/claude-plugin-harness/skills",
      "{{ .chezmoi.homeDir }}/.config/crush/skills-ext/stumpcloud-skills/skills",
      "{{ .chezmoi.homeDir }}/.config/claude-marketplaces/claude-personal/skills"
    ],
    "disabled_skills": [
      "refresh-miatrix-token",
      "self-report",
      "retirement-plan",
      "init",
      "prime",
      "report-friction",
      "index",
      "search",
      "work",
{{- /* Superseded by the canonical skills in stumpcloud/skills
       (skills-ext/stumpcloud-skills). Each disabled name has a stronger,
       maintained replacement there — do not re-enable without deleting the
       replacement. */}}
      "arr-triage",
      "stumpcloud-deploy",
      "proxmox-manage",
      "stumpcloud-zfs"
    ],
    "disabled_tools": []
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "glob",
      "sourcegraph",
      "fetch",
      "download",
      "edit",
      "multiedit",
      "write",
      "bash",
      "lsp_diagnostics",
      "lsp_references",
{{- /* Both semantic tools are read-only-ish and cheap to allow: semantic_search
       only queries the local sqlite index, and semantic_index writes nothing but
       that index (it embeds through the gateway above, on Joe's own GPU). They
       are listed for the same reason view/grep are — so an interactive Crush
       doesn't prompt for the two tools an agent should reach for FIRST when it
       lands in an unfamiliar repo. Absent from the palette entirely when the
       embeddings block above is missing, or when the local vec0 store fails to
       open — reachability of the gateway is never consulted at registration, so
       a box that can't reach it still gets both tools and fails at call time
       instead. */}}
      "semantic_search",
      "semantic_index",
      "todos",
      "list_mcp_resources",
      "read_mcp_resource",
      "mcp_filesystem_read_file",
      "mcp_filesystem_read_text_file",
      "mcp_filesystem_read_multiple_files",
      "mcp_filesystem_list_directory",
      "mcp_filesystem_directory_tree",
      "mcp_filesystem_search_files",
      "mcp_filesystem_get_file_info",
      "mcp_filesystem_list_allowed_directories",
      "mcp_memory_read_graph",
      "mcp_memory_search_nodes",
      "mcp_memory_open_nodes",
      "mcp_aws-knowledge_search",
      "mcp_aws-knowledge_get_documentation",
      "mcp_aws-knowledge_read_documentation",
      "mcp_aws-knowledge_recommend",
      "mcp_gitea_get_me",
      "mcp_gitea_get_file_contents",
