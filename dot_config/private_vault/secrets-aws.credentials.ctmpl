{{- /* Consul-Template, rendered by Vault Agent. NOT a chezmoi template. */ -}}
# Rendered by Vault Agent from OpenBao KV. DO NOT EDIT.
# Destination: ~/.config/aws/credentials — the shared-credentials file boto3
# reads when AWS_SHARED_CREDENTIALS_FILE points here. Two profiles:
#
#   [default]        — Joe's admin key (secret/users/$USER/aws), for CLI use.
#   [agent-readonly] — the read-only agent identity (secret/users/$USER/aws-readonly),
#                      for MCP servers and harness-launched agents.
#
# Guarded via the metadata listing (same pattern as secrets-aws.env.ctmpl):
# a fixed `with secret` read 404-loops for a user without the bag AND leaves a
# stale file in place. Ranging the metadata and acting only when the bag is
# present means a user without it renders cleanly to an empty file.
#
# See dotfiles#136 (non-interactive credential chain) and the AWS credential
# remediation plan (cairn.stump.wtf/ff2sAzRv).
{{- range secrets (printf "secret/metadata/users/%s/" (env "USER")) -}}
{{- if eq (. | trimSuffix "/") "aws" -}}
{{- with secret (printf "secret/data/users/%s/aws" (env "USER")) }}
[default]
aws_access_key_id = {{ .Data.data.AWS_ACCESS_KEY_ID }}
aws_secret_access_key = {{ .Data.data.AWS_SECRET_ACCESS_KEY }}
{{- end }}
{{- end }}
{{- end }}
{{- range secrets (printf "secret/metadata/users/%s/" (env "USER")) -}}
{{- if eq (. | trimSuffix "/") "aws-readonly" -}}
{{- with secret (printf "secret/data/users/%s/aws-readonly" (env "USER")) }}

[agent-readonly]
aws_access_key_id = {{ .Data.data.AWS_ACCESS_KEY_ID }}
aws_secret_access_key = {{ .Data.data.AWS_SECRET_ACCESS_KEY }}
{{- end }}
{{- end }}
{{- end }}
