# Timer for the scheduled StumpCloud sweep — systemd USER (no sudo), agent
# boxes only (see the .chezmoiignore role gate). First run shortly after
# boot, then every 6h. Managed by chezmoi.
[Unit]
Description=Run the StumpCloud sweep agent every 6h

[Timer]
OnStartupSec=15min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
