# chezmoi's own config. Managed by chezmoi (source: this file) — edit here, never
# the rendered ~/.config/chezmoi/chezmoi.toml.

# NO sourceDir — deliberately. chezmoi renders from its DEFAULT source location
# (~/.local/share/chezmoi): the PRODUCTION clone, which czu keeps on clean
# upstream main and which nothing else ever edits. Development happens in a
# separate ordinary checkout at ~/src/dotfiles (branches, dirt, worktrees — all
# fine there) that chezmoi never reads; work reaches machines only by merging to
# main upstream. Two checkouts, two roles, enforced by czu.
#
# History, because both failure modes have burned us: a single shared checkout
# (the previous model) entangled workbench and production — parked feature
# branches rendered into $HOME, unmerged commits ran in production, and czu grew
# stash/branch machinery that failed constantly. Before that, a two-clone setup
# ALSO failed — but only because neither clone had an enforced role, so the
# applied one silently rotted on a stale branch. The fix is not one checkout; it
# is czu_sync_prod refusing to render anything but clean upstream main.
#
# Anything reading the render path at runtime should ask `chezmoi source-path`
# (shell) or use {{ "{{ .chezmoi.sourceDir }}" }} (templates), never hardcode it.

[git]
    # Deliberately OFF. With these on, chezmoi committed and pushed on its own
    # whenever it touched the source tree — edits landed on the remote with no
    # review, no message you wrote, and no chance to run `bats test/` first. This
    # repo is a production service; commits here are deliberate. Use the normal
    # git flow in the source dir instead.
    autoCommit = false
    autoPush = false
