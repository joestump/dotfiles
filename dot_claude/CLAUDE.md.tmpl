{{- /*
  ~/.claude/CLAUDE.md — read by Claude Code (CLI) and by the Claude Code embedded
  in Claude Desktop. Both read THIS file; Claude Desktop's chat has no on-disk
  rules file of its own (its equivalent is Project instructions, stored in the
  cloud), so there is deliberately no CLAUDE_DESKTOP.md here.

  This file is pure composition — base policy + identity + harness overlay. Add a
  new rule to the right partial under .chezmoitemplates/agents/, never inline
  here, or it silently applies to Claude Code alone.
*/ -}}
{{ template "agents/base.md" . }}

{{/* Acting ROLE derives from whoami (.chezmoi.username, overridable per box
       via .agentIdentity) under the $USER / $USER-agent convention: a login
       carrying the `-agent` suffix is the bot, anything else is the human.
       See the Identity section in .chezmoidata.yaml. */ -}}
{{- $user := .agentIdentity | default .chezmoi.username -}}
{{- $role := hasSuffix "-agent" $user | ternary "agent" "human" -}}
{{ includeTemplate (printf "agents/identity-%s.md" $role) (merge (dict "harnessName" "Claude Code" "harnessUrl" "https://claude.ai") .) }}

{{ template "agents/harness-claude-code.md" . }}
