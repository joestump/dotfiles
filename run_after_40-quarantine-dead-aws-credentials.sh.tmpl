#!/usr/bin/env bash
# chezmoi run_after_ script: runs AFTER apply, EVERY apply. Quarantines a dead
# AWS credentials file left over from the pre-OpenBao era.
#
# ~/.aws/credentials was hand-written on the laptop and is NOT chezmoi-managed.
# It held the certbot key (AKIA...3UJCKLFZ) deactivated by the secrets OMG on
# 2026-08-03, and it is what boto3 falls through to when no env credential is
# set — which is every non-interactive launch context (Claude Desktop, harness
# agents, cron). The file is the whole reason the AWS MCP "works from a
# terminal and nowhere else".
#
# The replacement path (Vault Agent renders ~/.config/aws/credentials as INI
# with a [agent-readonly] profile) is wired by #147. This script is only safe
# to run once that file exists.
#
# NOT run_once_: the replacement almost never exists during the apply that
# introduces it. This script sorts before 40-vault-agent-service (the restart
# that makes the agent pick up the new template block), and Vault Agent renders
# asynchronously after that anyway — so the first apply always takes the
# skip branch below. chezmoi records a run_once_ script as done by content hash
# even when it exits 0 as a no-op, which would retire this permanently on the
# one run where it can never succeed. run_after_ costs two stats and a grep and
# fires on the next apply, once the replacement is really there.
#
# Moved, not deleted: the file may contain other profiles someone wants back.
# See the AWS credential remediation plan (cairn.stump.wtf/ff2sAzRv).
set -euo pipefail

CREDS="{{ .chezmoi.homeDir }}/.aws/credentials"
REPLACEMENT="{{ .chezmoi.homeDir }}/.config/aws/credentials"

# The replacement path must exist before we touch the old file.
if [ ! -f "$REPLACEMENT" ]; then
  echo "==> ~/.config/aws/credentials not rendered yet; skipping quarantine"
  exit 0
fi

# Nothing to quarantine.
if [ ! -f "$CREDS" ]; then
  exit 0
fi

# Only quarantine if it actually carries a known-dead key. A file with only
# live keys is unusual but not ours to move.
#
# One ID, deliberately. The original had a second, AKIA2VGW3QJCKLFZ, which is
# 16 characters — an AWS access key ID is always 20 (AKIA + 16), so it could
# never match the key it named, and a guard that cannot fire is worse than no
# guard because it reads as coverage. Dropped rather than guessed at. If a
# second dead key really is out there, add its full 20-character ID here.
if ! grep -q "AKIA4PUPMZ4S3UJCKLFZ" "$CREDS" 2>/dev/null; then
  exit 0
fi

DEST="${CREDS}.dead-$(date +%Y%m%d)"
mv "$CREDS" "$DEST"
echo "==> Quarantined $CREDS to $DEST (contains a deactivated AWS key)"
