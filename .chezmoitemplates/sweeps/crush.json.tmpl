{{- /*
  Lean Sweep Crush Config (partial)

  Rendered into every ~/sweeps/<job>/crush.json. Crush merges a project
  crush.json OVER the global ~/.config/crush/crush.json, so this can only add
  or override. That is why every unneeded MCP server is switched off with
  "disabled": true rather than removed: a crushrc `mcp remove` deletes only
  from its own file, which made the #234 sweeps crushrc a no-op — every sweep
  kept all ten servers and 163 MCP tool schemas.

  Measured on tars against litellm/Qwen3.8-27B (vLLM prompt tokens for a
  trivial run): the old sweeps profile started every session at 76,290 tokens,
  this profile at 11,596 with signal as the only server.

  Arguments, as a dict:
    .home   the home directory (for the RULES.md path)
    .mcp    MCP servers this job keeps
    .tools  optional builtin tools this job keeps ("edit", "multiedit")

  $servers must name every MCP server in dot_config/crush/crush.json.tmpl, or a
  new server silently rides into every sweep; test/lean-sweeps.bats checks it.

  @joestump 09/11/2026 - Added with the lean sweep profile.

  @joestump 09/11/2026 - Review: job_output and job_kill back on, and
    attribution trailers switched off (see the notes on each below).
*/ -}}
{{- $servers := list "aws" "aws-knowledge" "cairn" "chrome-devtools" "filesystem" "gitea" "memory" "msgbrowse" "outline" "sequential-thinking" "signal" "switchboard" -}}
{{- $mcp := dict -}}
{{- range $s := $servers -}}
{{- if not (has $s $.mcp) }}{{ $_ := set $mcp $s (dict "disabled" true) }}{{ end -}}
{{- end -}}
{{- /* Builtin tools no unattended sweep uses. fetch is here on purpose: a network
       error inside it aborts the whole crush run (crush fetch.go returns a Go
       error instead of a tool error), so sweeps check HTTP with curl instead.
       agent is a read-only search sub-agent in crush — it cannot run bash, so
       it is no help with deep per-PR or per-host work. job_output and job_kill
       stay ON: crush's bash tool moves any command still running after 60s
       into a background job that only job_output can read, so without it a
       make test, a build or a playbook run returns nothing (commands were
       auto-backgrounded in five sweep sessions between 09/06 and 09/11). */ -}}
{{- $off := list "agent" "agentic_fetch" "call_mcp_prompt" "crush_info" "crush_logs" "CronCreate" "CronDelete" "CronList" "download" "fetch" "list_mcp_prompts" "list_mcp_resources" "lsp_call_hierarchy" "lsp_definition" "lsp_diagnostics" "lsp_references" "lsp_rename" "lsp_replace_symbol" "lsp_restart" "lsp_symbols" "question" "read_mcp_resource" "semantic_index" "semantic_search" "sourcegraph" "todos" -}}
{{- range $t := list "edit" "multiedit" -}}
{{- if not (has $t $.tools) }}{{ $off = append $off $t }}{{ end -}}
{{- end -}}
{{- /* attribution: with no attribution key anywhere, crush defaults to an
       Assisted-by trailer plus a "Generated with Crush" line and writes both
       into its bash tool's commit and PR instructions. The full CRUSH.md
       countered that with its "no default footers" rule; RULES.md is too short
       to win that argument every time, so the sweep config switches it off. */ -}}
{{- $attribution := dict "trailer_style" "none" "generated_with" false -}}
{{- $opts := dict "attribution" $attribution "disable_a2ui" true "disabled_tools" $off "global_context_paths" (list (printf "%s/sweeps/lib/RULES.md" $.home)) -}}
{{ dict "mcp" $mcp "options" $opts | toPrettyJson }}
