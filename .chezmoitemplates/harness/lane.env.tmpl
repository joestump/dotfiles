{{- /*
  Lane Worker Env (partial)

  Rendered into every ~/.config/harness/<lane worker>.env. It only repoints
  CRUSH_GLOBAL_DATA at the worker's own pin dir, which holds its model and its
  lane's switchboard MCP (.chezmoitemplates/harness/lane-pin.json.tmpl) plus
  its session history.

  Arguments, as a dict:
    .name  the worker's harness name, as declared in .switchboard.lanes
    .home  the home directory

  @joestump 09/11/2026 - Added with the difficulty lanes.
*/ -}}
# Env for the {{ .name }} lane worker (referenced as env_file in harness.toml).
#
# NO SECRETS HERE. This file is committed. The provider key and the lane's
# switchboard URL and key come from ~/.config/vault/secrets-static.env, which
# the harness daemon loads before exec. See crush-switchboard.env for how
# harness layers this file over the daemon's environment.
CRUSH_GLOBAL_DATA={{ .home }}/.local/share/{{ .name }}
