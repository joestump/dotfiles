<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>rocks.stump.stumpcloud-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>[ -d "$HOME/src/stumpcloud/.git" ] || exit 0; . "$HOME/.config/vault/secrets-static.env" 2>/dev/null || true; cd "$HOME/src/stumpcloud" &amp;&amp; exec "$HOME/.local/bin/claude" -p "$(cat "$HOME/.config/dotfiles/stumpcloud-sweep.prompt.md")" --dangerously-skip-permissions</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>VAULT_ADDR</key>
        <string>{{ .vaultAddr }}</string>
        <key>PATH</key>
        <string>{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/.cache/stumpcloud-sweep.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/.cache/stumpcloud-sweep.log</string>
</dict>
</plist>
