# Halloy config — managed by chezmoi (joestump/dotfiles, user guide:
# https://stumpcloud.pages.stump.rocks/ansible/guides/irc/).
#
# SASL authenticates against the house LLDAP with your normal username and
# password. The password is deliberately NOT in this file: password_keyring
# makes Halloy prompt once and store it in the OS keychain (macOS Keychain /
# Secret Service). House server requires SASL, so the first connect will ask.
#
# Editing in Halloy's settings UI rewrites this file and chezmoi will flag the
# drift on the next apply — durable changes belong in dotfiles.

[servers.stump]
server = "irc.stump.rocks"
port = 6697
use_tls = true
nickname = "{{ .githubUser }}"
realname = "{{ .githubUser }}"

sasl.plain.username = "{{ .githubUser }}"
sasl.plain.password_keyring = true

[servers.liberachat]
nickname = "halloy6897"
server = "irc.libera.chat"
channels = ["#halloy"]
