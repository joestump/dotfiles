#!/usr/bin/env bash
# Build harness ("systemctl for your agents") → ~/.local/bin/harness.
#
# Structural twin of run_after_30-install-crush.sh — see that script for the full
# rationale; the differences are called out inline below.
#
# The source is cloned by the chezmoi external at ~/.local/share/harness-src
# ({{ .harnessRepo }}). The repo ships no release binaries, so there's nothing to
# download — we build from that clone into ~/.local/bin, which sorts ahead of
# /opt/homebrew/bin on PATH (see env.zsh).
#
# Rerun model (mirrors install-crush): runs on EVERY apply but is cheap when
# nothing changed — it fingerprints the clone by git HEAD and only rebuilds when
# HEAD moves (or the binary is missing). run_onchange wouldn't work here: the repo
# gaining commits doesn't change this script, so an onchange gate would never
# re-fire. For an immediate pull + rebuild: `chezmoi apply --refresh-externals`.
set -euo pipefail

# ~/.local/bin may not be on PATH in the shell that invoked chezmoi (a login shell
# opened before env.zsh added it). Add it so `command -v`/go resolve.
export PATH="$HOME/.local/bin:$PATH"

SRC="$HOME/.local/share/harness-src"
BIN="$HOME/.local/bin/harness"
STATE="$HOME/.config/dotfiles/.harness-build-state"

# Clean progress via the shared UI lib (spinner on a TTY, quiet otherwise);
# fallback keeps the script working if the lib hasn't been applied yet.
. "$HOME/.config/dotfiles/ui-lib.sh" 2>/dev/null || {
  step() { shift; [ "${1:-}" = "--" ] && shift; "$@"; }
  heading() { printf '\n== %s ==\n' "$*"; }
  item() { shift; echo "    - $*"; }
  say()  { echo "  $*"; }; warn() { echo "  WARN: $*" >&2; }
}

# The external clones the source; if it isn't there yet, there's nothing to build.
[ -d "$SRC/.git" ] || { echo "harness source not cloned yet ($SRC); skipping build"; exit 0; }

# Keep the managed clone pointed at the configured repo. chezmoi's git-repo
# external clones a fresh machine from {{ .harnessRepo }} correctly, but it will
# NOT re-point an EXISTING clone when .harnessRepo changes (it just `git pull`s the
# old remote) — so reconcile the remote here. Safe on the managed clone: nothing is
# developed in it (ff-only pull), and the reset just tracks the new default branch.
WANT="{{ .harnessRepo }}"
if [ "$(git -C "$SRC" remote get-url origin 2>/dev/null)" != "$WANT" ]; then
  echo "==> repointing harness clone → $WANT"
  git -C "$SRC" remote set-url origin "$WANT"
fi

# Always fetch and sync to origin's default branch on every apply so we have the
# absolute latest commits without waiting for chezmoi's external refresh period.
# Safe because nothing is developed in this clone.
if git -C "$SRC" fetch --quiet --prune origin; then
  DEF="$(git -C "$SRC" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
  git -C "$SRC" reset --hard "$DEF" >/dev/null 2>&1 || git -C "$SRC" reset --hard origin/main >/dev/null 2>&1 || true
else
  warn "fetch failed — building from current local state"
fi

# Building needs the Go toolchain (Brewfile installs it on macOS; on a headless
# Linux node without `go` this is a graceful no-op). GOTOOLCHAIN=auto lets an older
# Go fetch the exact version go.mod pins.
command -v go >/dev/null 2>&1 || { echo "go toolchain absent; skipping harness build"; exit 0; }

# GOPRIVATE must be set HERE, not inherited. It is exported by
# dot_oh-my-zsh/custom/go.zsh.tmpl, which only a login zsh reads — and a chezmoi
# run script executes under sh during apply, with almost none of that
# environment. Without it, `go build` resolves private modules through the
# PUBLIC proxy and checksum database and dies:
#
#   go: gitea.stump.rocks/stump.wtf/harness@v0.1.0: verifying module:
#       reading https://sum.golang.org/lookup/...: 404 Not Found
#
# Same shape as the `{{ "{{ if env ... }}" }}` gating trap this repo already
# banned: a scheduled apply has no environment, so anything depending on the
# login shell silently behaves differently under czu than it does by hand.
# Observed on tars 2026-08-10 — the binary had been stale for weeks.
export GOPRIVATE="{{ trimPrefix "https://" .giteaUrl }}/*,github.com/{{ .githubUser }}/*,github.com/{{ .githubUser }}-agent/*"
export GONOSUMDB="$GOPRIVATE"
export GONOSUMCHECK=1


# Restart The Daemon When — And Only When — Its Binary Changed
#
# Writing a new binary to ~/.local/bin/harness does nothing to the daemon
# already running the old one: it keeps serving from the executable it started
# with until something restarts it. That used to happen by accident, because
# harness.service declared Requires=vault-agent.service and czu restarts the
# Vault Agent on every run — so the daemon was dragged down and back up four
# times a day. Accidental, and expensive: every restart SIGTERMs every live
# agent session, and every scheduled harness fires again on the way back up
# (harness#266).
#
# That coupling is gone (Wants= now — see harness.service.tmpl), so the restart
# has to be deliberate, and this script is the only place that knows a new
# binary actually landed. Called ONLY from the two build-success paths: an
# apply that finds the fingerprint unchanged has already exited above, and a
# failed build must never bounce a working daemon onto a binary it did not
# produce.
#
# In-flight sessions still die on an upgrade. That is unavoidable when the
# supervisor itself is what is being replaced, and it is strictly rarer than
# the every-6h bounce it replaces. A machine where the daemon is not up yet is
# left alone: run_onchange_after_51 owns enabling and starting it.
#
# @joestump-agent 08/25/2026 - Added alongside the Requires= → Wants= change,
#   so a harness upgrade still lands promptly once czu stopped restarting the
#   daemon as a side effect.
restart_daemon() {
  _ver="$1"
  if [ "$(uname)" = "Darwin" ]; then
    if ! launchctl print "gui/$(id -u)/rocks.stump.harness" >/dev/null 2>&1; then
      item dim "harness daemon not loaded — skipping restart"
      return 0
    fi
    if launchctl kickstart -k "gui/$(id -u)/rocks.stump.harness" >/dev/null 2>&1; then
      item ok "harness daemon restarted onto ${_ver}"
    else
      warn "could not restart the harness daemon — launchctl kickstart -k gui/$(id -u)/rocks.stump.harness"
    fi
    return 0
  fi

  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if ! systemctl --user is-active --quiet harness.service 2>/dev/null; then
    item dim "harness daemon not running — skipping restart"
    return 0
  fi
  if systemctl --user restart harness.service 2>/dev/null; then
    item ok "harness daemon restarted onto ${_ver}"
  else
    warn "could not restart the harness daemon — systemctl --user restart harness.service"
  fi
}

heading "🛠  harness"

head="$(git -C "$SRC" rev-parse HEAD 2>/dev/null || true)"
if [ -x "$BIN" ] && [ -n "$head" ] && [ "$head" = "$(cat "$STATE" 2>/dev/null || true)" ]; then
  item ok "harness ${head:0:7} (up to date)"
  exit 0
fi

# Flags mirror the repo's own Makefile `build` target (GOFLAGS + LDFLAGS) so a
# chezmoi-built binary is identical to a `make install` one. We invoke `go build`
# directly rather than `make install` to avoid depending on make, exactly as the
# crush script does — if the Makefile's flags change upstream, update these to match.
# Deliberately NOT setting CGO_ENABLED=0 (crush does): harness's Makefile leaves
# cgo at the default, and forcing it off here would build a different binary.
ver="$(git -C "$SRC" describe --tags --always --dirty 2>/dev/null || echo dev)"
mkdir -p "$(dirname "$BIN")" "$(dirname "$STATE")"

say "building harness ${ver}…"
if ( cd "$SRC" && GOTOOLCHAIN=auto \
       go build -trimpath \
         -ldflags "-X gitea.stump.rocks/stump.wtf/harness/internal/buildinfo.Version=${ver}" \
         -o "$BIN" ./cmd/harness ); then
  printf '%s' "$head" >"$STATE"
  item ok "harness ${ver} → $BIN"
  restart_daemon "$ver"
else
  # Exit non-zero so the failure actually surfaces. This used to only warn, so
  # czu completed "ok", the scheduled-state file stayed ok, no Signal alert
  # fired — and the stale binary kept running. A build that fails while the
  # toolchain and the clone are both present is a real fault, and the whole
  # point of the scheduled run is that a failure means something.
  #
  # Note the state file is only written on success, so a failed build never
  # marks itself up to date; the next run retries from scratch.
  # Retry once before failing. czu.timer is Persistent=true with no OnBootSec,
  # so a run missed while the machine was off fires within minutes of boot — and
  # czu.service is ordered After=network-online.target, which says nothing about
  # the FORGE being up, because gitea lives on a different machine. A cold boot
  # therefore races the forge and `go build` fails fetching modules.
  #
  # Without this, the exit 1 below would Signal-alert on every reboot — and an
  # alert that cries wolf gets ignored, which is the same disease as the silence
  # it replaced. One retry separates "the forge was still coming up" from "the
  # build is broken": a real failure fails twice and still exits non-zero.
  warn "harness build failed — retrying once in 20s (forge may still be coming up)"
  sleep 20
  if ( cd "$SRC" && GOTOOLCHAIN=auto \
       go build -trimpath \
         -ldflags "-X gitea.stump.rocks/stump.wtf/harness/internal/buildinfo.Version=${ver}" \
         -o "$BIN" ./cmd/harness ); then
    printf '%s' "$head" >"$STATE"
    item ok "harness ${ver} → $BIN (succeeded on retry)"
    restart_daemon "$ver"
  else
    warn "harness build failed twice — 'cd $SRC && go build ./cmd/harness' by hand to see why"
    exit 1
  fi
fi
