#!/usr/bin/env bash
# Install Ansible for StumpCloud infrastructure management.
#
# This script owns the ~/src/ansible clone — it is deliberately NOT a chezmoi
# external, because agents develop there and an external's ff-only pull aborts
# the whole apply when the checkout sits on a work branch (see
# .chezmoiexternal.toml). The stumpcloud/ansible repo
# uses Pipenv for dependency management. On Ubuntu 24.04+, PEP 668 blocks
# `pip install --user`, so we use uv (already available) to create a venv
# and install pipenv there. This avoids the externally-managed-environment error.
#
# Rerun model: runs on EVERY apply but is cheap when already installed.
set -euo pipefail

# ~/.local/bin may not be on PATH in the shell that invoked chezmoi (a login shell
# opened before env.zsh added it). Add it so `command -v` works.
export PATH="$HOME/.local/bin:$PATH"

repo="$HOME/src/ansible"
venv="$HOME/.local/share/ansible-venv"

# Clean progress via the shared UI lib (spinner on a TTY, quiet otherwise);
# fallback keeps the script working if the lib hasn't been applied yet.
. "$HOME/.config/dotfiles/ui-lib.sh" 2>/dev/null || {
  have() { command -v "$1" >/dev/null 2>&1; }
  step() { shift; [ "${1:-}" = "--" ] && shift; "$@"; }
  heading() { printf '\n== %s ==\n' "$*"; }
  item() { shift; echo "    - $*"; }
  say()   { echo "  $*"; }
  warn() { echo "  WARN: $*" >&2; }
}

heading "🔧 Ansible (StumpCloud)"

# Clone if missing (this script replaced the chezmoi external as the owner).
if [ ! -d "$repo/.git" ]; then
  if ! step "cloning stumpcloud/ansible" -- git clone --quiet https://gitea.stump.rocks/stumpcloud/ansible.git "$repo"; then
    warn "clone failed — skipping ansible setup"
    exit 0
  fi
fi

# Refresh ONLY when the checkout is passively sitting on the default branch.
# Agents develop here — work branches and fork remotes are normal, and touching
# them (or failing on them) is how czu used to break. Skip quietly instead.
DEF="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
DEF="${DEF#origin/}"
BRANCH="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)"
if [ "$BRANCH" = "$DEF" ]; then
  if git -C "$repo" fetch --quiet --prune origin 2>/dev/null \
     && git -C "$repo" merge --ff-only --quiet "origin/$DEF" 2>/dev/null; then
    item ok "ansible at $(git -C "$repo" rev-parse --short HEAD)"
  else
    warn "refresh failed (local commits? offline?) — running from current HEAD"
  fi
else
  item dim "ansible on work branch '$BRANCH' — leaving it alone"
fi

# Use uv to create a venv and install pipenv (avoids PEP 668 externally-managed-environment).
have uv || { item dim "uv absent — skipping ansible setup"; exit 0; }

# Create venv if needed.
if [ ! -d "$venv" ]; then
  say "creating ansible venv..."
  uv venv "$venv" --quiet
  item ok "venv created at $venv"
fi

# Install pipenv in the venv if needed.
if [ ! -x "$venv/bin/pipenv" ]; then
  say "installing pipenv..."
  uv pip install --python "$venv/bin/python" pipenv --quiet
  item ok "pipenv installed"
else
  item ok "pipenv already installed"
fi

# Create a wrapper script so `pipenv` is on PATH.
mkdir -p "$HOME/.local/bin"
cat > "$HOME/.local/bin/pipenv" << 'EOF'
#!/bin/bash
exec "$HOME/.local/share/ansible-venv/bin/pipenv" "$@"
EOF
chmod +x "$HOME/.local/bin/pipenv"

# Sync the ansible repo's venv. This downloads dependencies defined in Pipfile.lock.
# Use the wrapper pipenv which points to our isolated venv.
export PIPENV_IGNORE_VIRTUALENVS=1
export PIPENV_VENV_IN_PROJECT=1
# `pipenv sync` has no --dir flag (that was invented); the documented way to run it
# against a repo you aren't cd'd into is PIPENV_PIPFILE. Passing --dir made pipenv
# exit 2 on argparse ("unrecognized arguments") on every single apply.
export PIPENV_PIPFILE="$repo/Pipfile"

# Pin the interpreter. The Pipfile only asks for python_version = "3", so pipenv
# builds the venv with whatever `python3` is newest — currently 3.14, where the
# pinned rpds-py has no wheel and its Rust build fails, taking the whole sync down.
# Newest-known-good first; PIPENV_VENV_IN_PROJECT puts the venv at $repo/.venv.
pipenv_python=""
for _py in python3.13 python3.12; do
  if command -v "$_py" >/dev/null 2>&1; then
    pipenv_python="$(command -v "$_py")"
    break
  fi
done

pipenv_args=()
if [ -n "$pipenv_python" ]; then
  pipenv_args=(--python "$pipenv_python")
  # A venv already built on a too-new interpreter stays broken forever, because
  # pipenv reuses it and --python is ignored once .venv exists. Discard it first.
  if [ -x "$repo/.venv/bin/python" ] && \
     ! "$repo/.venv/bin/python" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] < (3, 14) else 1)' 2>/dev/null; then
    say "discarding .venv built on an unsupported python"
    rm -rf "$repo/.venv"
  fi
else
  warn "no python3.13/3.12 found — letting pipenv choose (may fail on 3.14)"
fi

# Capture rather than discard: sending stderr to /dev/null made every failure
# look identical ("pipenv sync failed") with no clue what actually broke. Keep
# the output off the clean `step` line on success, but surface the tail of it
# when the sync fails.
#
# Run from a subshell cd'd into the repo rather than `pipenv sync --dir`: the
# `--dir` flag is missing on some pipenv builds (this box's pipenv 2026.6.2
# rejects --dir and prints usage), and `cd` works on every version.
pipenv_log="$(mktemp)"
trap 'rm -f "$pipenv_log"' EXIT
if ! step "syncing pipenv venv" -- pipenv sync --quiet ${pipenv_args[@]+"${pipenv_args[@]}"} >"$pipenv_log" 2>&1; then
  warn "pipenv sync failed; first run may cold-start"
  while IFS= read -r line; do
    warn "  $line"
  done < <(tail -5 "$pipenv_log")
fi
rm -f "$pipenv_log"

item ok "ansible ready at $repo (run: pipenv run ansible-playbook ...)"
