#!/usr/bin/env bash
# Keep Claude Code plugins (claude-plugins.tsv) installed AND current.
#
# Runs on EVERY apply (cheap when nothing changed: one `claude plugin list`).
# Why not run_onchange? New skills pushed to the private Gitea marketplace don't
# change the tsv, so an onchange gate would never re-fire and the skills would
# never propagate.
#
# Propagation model:
#   • LOCAL-PATH marketplace (the Gitea one, cloned by a chezmoi external):
#     fingerprinted by the clone's git HEAD. When HEAD moves we REINSTALL —
#     because authors don't always bump the plugin `version`, and
#     `claude plugin update` is a no-op when the version is unchanged (that's
#     exactly why a freshly-added skill silently failed to appear).
#   • REMOTE marketplaces (GitHub, or a Gitea URL): install-once. Their cache
#     is refreshed with `marketplace update` before every install attempt, so a
#     marketplace whose entry was broken when we first cloned it can recover on
#     a later run. An already-installed remote plugin is left alone — upgrading
#     one is still a manual `claude plugin update`.
#
# The clone itself is refreshed by the chezmoi external (refreshPeriod). For an
# immediate pull+propagate after pushing skills: `chezmoi apply --refresh-externals`.
set -euo pipefail

# claude installs to ~/.local/bin. chezmoi may be invoked from a shell that
# hasn't put that on PATH (e.g. a still-open login shell from before env.zsh
# added it), which would make us wrongly skip "claude absent". Add it here.
export PATH="$HOME/.local/bin:$PATH"

command -v claude >/dev/null 2>&1 || { echo "claude CLI absent; skipping plugins"; exit 0; }
LIST="$HOME/.config/dotfiles/claude-plugins.tsv"
[ -f "$LIST" ] || { echo "no claude-plugins.tsv; skipping"; exit 0; }
STATE="$HOME/.config/dotfiles/.claude-plugin-state"; mkdir -p "$STATE"

# One `name@marketplace` per line, stripped of decoration. `claude plugin list`
# is a HUMAN-formatted listing, not a machine interface — it currently prints
#     Installed plugins:
#
#       ❯ **claude-skills@joestump**
#           Version: 1.0.0
# so the old whole-line `grep -qxF` match never matched anything, and every
# plugin silently took the "not installed" branch below forever. That made the
# HEAD-moved refresh branch dead code, which is the real reason a freshly pushed
# skill never reached the harnesses. Extracting the name@marketplace token
# instead of trusting the layout survives the next cosmetic change to that output.
installed="$(claude plugin list 2>/dev/null | grep -oE '[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+' || true)"

# Clean progress via the shared UI lib (spinner on a TTY, quiet line otherwise);
# fallback keeps the script working if the lib hasn't been applied yet.
. "$HOME/.config/dotfiles/ui-lib.sh" 2>/dev/null || {
  step() { shift; [ "${1:-}" = "--" ] && shift; "$@"; }
  heading() { printf '\n== %s ==\n' "$*"; }
  item() { shift; echo "    - $*"; }
  say()  { echo "  $*"; }; warn() { echo "  WARN: $*" >&2; }
}

heading "🔌 Claude plugins"
while read -r src plugin _rest <&3 || [ -n "${src:-}" ]; do
  case "$src" in ''|\#*) continue ;; esac
  [ -n "${plugin:-}" ] || continue
  src="${src/#\~/$HOME}"                              # expand a leading ~
  mp="${plugin##*@}"                                  # marketplace name (after @)
  sentinel="$STATE/${plugin//[^A-Za-z0-9_.@-]/_}"

  # Fingerprint local-path marketplaces by git HEAD; remote ones have no local
  # .git so head stays empty (install-once).
  head=""
  [ -d "$src/.git" ] && head="$(git -C "$src" rev-parse HEAD 2>/dev/null || true)"

  # Exact-name match: `claude plugin list` prints one plugin per line; a bare
  # grep -F would substring-match (e.g. qmd@qmd inside my-qmd@qmd). Anchor with
  # -x so the WHOLE line must equal the plugin name (dotfiles#19).
  if ! grep -qxF "$plugin" <<<"$installed"; then
    # `marketplace add` and `marketplace update` must BOTH run, unconditionally.
    # They used to be chained with `||`, but `add` exits 0 for an
    # already-registered marketplace, so the update never fired and the cached
    # marketplace.json froze at whatever commit it was first cloned at. When
    # that first clone carried a broken entry the failure was permanent and
    # self-perpetuating: install fails -> plugin never appears in `plugin list`
    # -> we take this branch again -> `add` succeeds -> still no update. That is
    # exactly how harness@claude-plugin-harness stayed uninstallable for three
    # months against a marketplace whose main had been fixed 28 minutes after
    # the bad clone (dotfiles#124).
    claude plugin marketplace add "$src" </dev/null >/dev/null 2>&1 || true
    claude plugin marketplace update "$mp" </dev/null >/dev/null 2>&1 || true
    if step "$plugin" -- claude plugin install "$plugin" </dev/null; then printf '%s' "$head" >"$sentinel"; else warn "install $plugin failed"; fi
  elif [ -n "$head" ] && [ "$head" != "$(cat "$sentinel" 2>/dev/null || true)" ]; then
    claude plugin marketplace update "$mp" </dev/null >/dev/null 2>&1 || true
    claude plugin uninstall "$plugin" </dev/null >/dev/null 2>&1 || true
    # Purge the version-keyed cache before reinstalling. `claude` caches a plugin
    # at ~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/ and that dir
    # SURVIVES `plugin uninstall`, so reinstalling at an unchanged version reuses
    # the stale copy: the install reports success, we write the sentinel, and the
    # newly pushed skill never appears — permanently, because from then on the
    # sentinel matches and this branch stops firing. Bumping the plugin version
    # also fixes it, but the whole reason this branch exists is that authors don't
    # reliably bump versions, so don't depend on it. Guarded so a malformed line
    # can never turn this into `rm -rf` on a short path.
    pname="${plugin%@*}"
    if [ -n "$pname" ] && [ -n "$mp" ]; then
      rm -rf "$HOME/.claude/plugins/cache/$mp/$pname" 2>/dev/null || true
    fi
    if step "$plugin → ${head:0:7}" -- claude plugin install "$plugin" </dev/null; then printf '%s' "$head" >"$sentinel"; else warn "refresh $plugin failed"; fi
  else
    item ok "$plugin"
  fi
done 3< "$LIST"
