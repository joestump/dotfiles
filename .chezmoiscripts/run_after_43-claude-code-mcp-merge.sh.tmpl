#!/usr/bin/env bash
# Merge the shared MCP server set into Claude Code (~/.claude.json).
# Reruns when the base defs or lib change:
# base hash: {{ include "dot_config/dotfiles/mcp-servers.json" | sha256sum }}
# lib  hash: {{ include "dot_config/dotfiles/mcp-merge-lib.sh" | sha256sum }}
set -euo pipefail

# Shared UI lib (ticked items on a TTY, quiet lines otherwise) — sourced BEFORE
# mcp-merge-lib so its status lines render as items. Fallback keeps us working if
# the lib hasn't been applied yet.
. "$HOME/.config/dotfiles/ui-lib.sh" 2>/dev/null || {
  heading() { printf '\n== %s ==\n' "$*"; }
  item() { shift; echo "    - $*"; }
  warn() { echo "  WARN: $*" >&2; }
}
. "$HOME/.config/dotfiles/mcp-merge-lib.sh"

CJ="$HOME/.claude.json"
heading "🔗 Claude Code MCP"
[ -f "$CJ" ] || { item dim "no ~/.claude.json — skipping"; exit 0; }

# karakeep + outline + gitea tokens are baked here at apply time (from
# OpenBao). karakeep is the npm @karakeep/mcp via npx (no Docker).
#
# gitea used to be the exception: the config carried only GITEA_HOST and the server
# was expected to inherit GITEA_ACCESS_TOKEN from the launching shell (env.zsh).
# That assumption only holds when a human starts `claude` from an INTERACTIVE zsh —
# oh-my-zsh custom files are not loaded by a login-less shell, so any headless or
# daemon-launched session (the joestump-agent runner, systemd --user, cron, a
# desktop launcher) started gitea-mcp with no token at all. The failure was silent
# and late: gitea-mcp answers reads on public repos unauthenticated, so issues, PRs
# and Actions all worked and only the first WRITE failed, with "token is required".
# Bake it like the others — a subprocess that gets its token from the config works
# no matter who launched it.
#
# Fallbacks read the prior value from its current home (ltrimstr is a no-op on a
# bare token, so a pre-migration env value also passes).
KK="$(mcp_secret karakeep KARAKEEP_API_KEY             "$(jq -r '.mcpServers.karakeep.env.KARAKEEP_API_KEY // ""'      "$CJ")")"
GT="$(mcp_secret gitea    GITEA_TOKEN                  "$(jq -r '.mcpServers.gitea.env.GITEA_ACCESS_TOKEN // ""'      "$CJ")")"
# outline is native http (not a subprocess), so it can't inherit the shell env, and
# Claude Code doesn't expand ${VAR} in http headers — so bake the Bearer token at
# apply time from the Vault-Agent-rendered secrets (like karakeep/gitea). The token
# never lands in the chezmoi repo.
OT="$( . "$HOME/.config/vault/secrets-static.env" >/dev/null 2>&1; printf '%s' "${OUTLINE_API_TOKEN:-}" )"
# cairn: native http + a STATIC Bearer, baked at apply time (same reason as outline
# — Claude Code doesn't expand ${VAR} in http headers). Crush has had this server
# since it was stood up; both Claude clients were simply never given it, so agents
# here could not read or post trajectories at all.
CN="$(mcp_secret cairn CAIRN_API_TOKEN "$(jq -r '(.mcpServers.cairn.headers.Authorization // "") | ltrimstr("Bearer ")' "$CJ")")"

# The cairn base URL is pushed in from OpenBao (secrets-static.env), same as the
# token — NOT hardcoded here. Crush reaches the server through the very same var
# ($CAIRN_BASE_URL); it expands it at runtime, whereas Claude Code doesn't expand
# ${VAR} in an http url, so bake it at apply time. Fallback recovers the URL already
# in the live config, so a transient miss leaves a working entry alone.
CN_URL="$(mcp_env CAIRN_BASE_URL "")"
CN_URL="${CN_URL:+${CN_URL}/mcp}"
CN_URL="${CN_URL:-$(jq -r '.mcpServers.cairn.url // ""' "$CJ")}"

# signal is OS-specific: the uv binary path and env PATH differ macOS vs Linux; the
# repo dir is ~/src/signal-mcp on both (Joe's dev checkout on the Mac, a chezmoi
# external clone on Linux). Resolve those here. The daemon it talks to (tcp
# 127.0.0.1:7583) is supervised by launchd (macOS) / systemd --user (Linux).
{{- if eq .chezmoi.os "darwin" }}
SIG_UV="{{ (lookPath "uv") | default "/opt/homebrew/bin/uv" }}"
SIG_PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{- else }}
SIG_UV="{{ .chezmoi.homeDir }}/.local/bin/uv"
SIG_PATH="{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin:/usr/local/bin"
{{- end }}
SIG_DIR="{{ .chezmoi.homeDir }}/src/signal-mcp"

desired="$(mcp_base | jq \
  --arg kk "$KK" --arg ot "$OT" --arg gt "$GT" --arg cn "$CN" \
  --arg cnurl "$CN_URL" \
  --arg uv "$SIG_UV" --arg sigdir "$SIG_DIR" --arg sigpath "$SIG_PATH" '
    (if $kk != "" then .karakeep.env.KARAKEEP_API_KEY = $kk else . end)
  # gitea: stdio subprocess reading GITEA_ACCESS_TOKEN from its own env, so it no
  # longer depends on the launching shell having sourced env.zsh. Guarded on
  # non-empty for the same reason as karakeep — a fresh machine before
  # `vault-oidc-login` must not get an empty token baked in.
  | (if $gt != "" then .gitea.env.GITEA_ACCESS_TOKEN = $gt else . end)
  | map_values(. + {type:"stdio"})                              # Claude Code uses an explicit type
  # outline: native http + a STATIC Bearer token (no OAuth/refresh tokens), baked.
  | (if $ot != "" then .outline = {type:"http", url:"https://outline.stump.rocks/mcp",
                headers:{"Authorization": ("Bearer " + $ot)}} else . end)
  # cairn: native http + static Bearer (baked). Both halves resolved above; only set
  # when BOTH are non-empty so a fresh machine never bakes a broken "Bearer " or a
  # url-less entry (cf. dotfiles#15).
  | (if $cn != "" and $cnurl != "" then .cairn = {type:"http", url:$cnurl,
                headers:{"Authorization": ("Bearer " + $cn)}} else . end)
  # msgbrowse: local-only http mcp; darwin only (Claude Code is macOS-desktop-native).
  # No auth — localhost-only.
  | (if "{{ .chezmoi.os }}" == "darwin" then .msgbrowse = {type:"http", url:"{{ .msgbrowseMcpEndpoint }}"} else . end)
  # signal: thin JSON-RPC client launched via uv; paths resolved per-OS above.
  | .signal = {type:"stdio", command:$uv,
               args:["run","--directory",$sigdir,"signal-mcp","--transport","stdio"],
               env:{PATH:$sigpath}}
')"

# Retirements. mcp_drop edits the LIVE config, which is the only way to REMOVE a
# server — mcp_merge below only ever adds or replaces, so an entry that merely stops
# being generated survives forever.
#
# Leaving a server out of `desired` is NOT a removal, which #239 shipped without
# noticing: mcp_merge is additive (managed servers replace live ones, everything else
# is preserved), so a key absent from `desired` stays in the live config. The laptop
# kept its switchboard entry through a full apply that reported "mcpServers already
# current". Only mcp_drop removes.
#
# switchboard is dropped on EVERY host, worker hosts included. The MCP is a worker
# capability — holding it means receiving doorbells and being expected to drain them
# — and Claude Code has no queue worker left, so any entry is an endpoint that
# quietly collects todos nobody claims. That is the failure that put 62 of them on
# Joe's laptop; with the claude-headless pool gone it would be kitt and tars next.
# Crush's switchboard MCP (crush.json.tmpl, gated on .switchboard.workerHosts) stays.
#
# @joestump 09/11/2026 - Stopped baking switchboard anywhere and drop it on every
#   host: the claude-headless pool that drained the Claude Code endpoint was
#   retired (stump.wtf/switchboard#185).
mcp_drop   "$CJ" github switchboard
mcp_merge "$CJ" "$desired"
