#!/usr/bin/env bash
# Merge the shared MCP server set into Claude Code (~/.claude.json).
# Reruns when the base defs or lib change:
# base hash: {{ include "dot_config/dotfiles/mcp-servers.json" | sha256sum }}
# lib  hash: {{ include "dot_config/dotfiles/mcp-merge-lib.sh" | sha256sum }}
set -euo pipefail

# Shared UI lib (ticked items on a TTY, quiet lines otherwise) — sourced BEFORE
# mcp-merge-lib so its status lines render as items. Fallback keeps us working if
# the lib hasn't been applied yet.
. "$HOME/.config/dotfiles/ui-lib.sh" 2>/dev/null || {
  heading() { printf '\n== %s ==\n' "$*"; }
  item() { shift; echo "    - $*"; }
  warn() { echo "  WARN: $*" >&2; }
}
. "$HOME/.config/dotfiles/mcp-merge-lib.sh"

CJ="$HOME/.claude.json"
heading "🔗 Claude Code MCP"
[ -f "$CJ" ] || { item dim "no ~/.claude.json — skipping"; exit 0; }

# github + karakeep + outline tokens are baked here at apply time (from OpenBao).
# github is the REMOTE hosted GitHub MCP (api.githubcopilot.com) — native http with
# a PAT Bearer, exactly like outline: no Docker, no local runtime. karakeep is the
# npm @karakeep/mcp via npx (no Docker). gitea needs NO token in the config: it
# inherits GITEA_ACCESS_TOKEN from the launching shell (env.zsh) — nothing
# gitea-related lands in ~/.claude.json beyond GITEA_HOST.
# Fallbacks read the prior value from its current home (github → Bearer header;
# ltrimstr is a no-op on a bare token, so a pre-migration env value also passes).
GH="$(mcp_secret github   GITHUB_PERSONAL_ACCESS_TOKEN "$(jq -r '(.mcpServers.github.headers.Authorization // .mcpServers.github.env.GITHUB_PERSONAL_ACCESS_TOKEN // "") | ltrimstr("Bearer ")' "$CJ")")"
KK="$(mcp_secret karakeep KARAKEEP_API_KEY             "$(jq -r '.mcpServers.karakeep.env.KARAKEEP_API_KEY // ""'      "$CJ")")"
# outline is native http (not a subprocess), so it can't inherit the shell env, and
# Claude Code doesn't expand ${VAR} in http headers — so bake the Bearer token at
# apply time from the Vault-Agent-rendered secrets (like github/karakeep). The token
# never lands in the chezmoi repo.
OT="$( . "$HOME/.config/vault/secrets-static.env" >/dev/null 2>&1; printf '%s' "${OUTLINE_API_TOKEN:-}" )"
# switchboard: native http + a STATIC Bearer, baked here at apply time (same reason as
# outline — Claude Code doesn't expand ${VAR} in http headers). Token from OpenBao via
# the Vault-Agent-rendered secrets-static.env (SWITCHBOARD_CLAUDE_CODE_API_KEY);
# mcp_secret's live fallback avoids blanking a working token on a transient miss.
# Claude Code ONLY — deliberately NOT added to the Claude Desktop merge (44).
SB="$(mcp_secret switchboard SWITCHBOARD_CLAUDE_CODE_API_KEY "$(jq -r '(.mcpServers.switchboard.headers.Authorization // "") | ltrimstr("Bearer ")' "$CJ")")"
# cairn: native http + a STATIC Bearer, baked at apply time (same reason as outline
# and switchboard — Claude Code doesn't expand ${VAR} in http headers). Crush has
# had this server since it was stood up; both Claude clients were simply never
# given it, so agents here could not read or post trajectories at all.
CN="$(mcp_secret cairn CAIRN_API_TOKEN "$(jq -r '(.mcpServers.cairn.headers.Authorization // "") | ltrimstr("Bearer ")' "$CJ")")"

# Both base URLs are pushed in from OpenBao (secrets-static.env), same as the
# tokens — NOT hardcoded here. Crush already reaches both servers through these
# very vars ($CAIRN_BASE_URL, $SWITCHBOARD_BASE_URL); it expands them at runtime,
# whereas Claude Code doesn't expand ${VAR} in an http url, so bake them at apply
# time. Fallback recovers the URL already in the live config, so a transient miss
# leaves a working entry alone. The switchboard path segment is per-client and
# minted by switchboard, so it stays in chezmoidata.
SB_URL="$(mcp_env SWITCHBOARD_BASE_URL "")"
SB_URL="${SB_URL:+${SB_URL}{{ .switchboardMcpPath }}}"
SB_URL="${SB_URL:-$(jq -r '.mcpServers.switchboard.url // ""' "$CJ")}"
CN_URL="$(mcp_env CAIRN_BASE_URL "")"
CN_URL="${CN_URL:+${CN_URL}/mcp}"
CN_URL="${CN_URL:-$(jq -r '.mcpServers.cairn.url // ""' "$CJ")}"

# signal is OS-specific: the uv binary path and env PATH differ macOS vs Linux; the
# repo dir is ~/src/signal-mcp on both (Joe's dev checkout on the Mac, a chezmoi
# external clone on Linux). Resolve those here. The daemon it talks to (tcp
# 127.0.0.1:7583) is supervised by launchd (macOS) / systemd --user (Linux).
{{- if eq .chezmoi.os "darwin" }}
SIG_UV="{{ (lookPath "uv") | default "/opt/homebrew/bin/uv" }}"
SIG_PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{- else }}
SIG_UV="{{ .chezmoi.homeDir }}/.local/bin/uv"
SIG_PATH="{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin:/usr/local/bin"
{{- end }}
SIG_DIR="{{ .chezmoi.homeDir }}/src/signal-mcp"

desired="$(mcp_base | jq \
  --arg gh "$GH" --arg kk "$KK" --arg ot "$OT" --arg sb "$SB" --arg cn "$CN" \
  --arg sburl "$SB_URL" --arg cnurl "$CN_URL" \
  --arg uv "$SIG_UV" --arg sigdir "$SIG_DIR" --arg sigpath "$SIG_PATH" '
    (if $kk != "" then .karakeep.env.KARAKEEP_API_KEY = $kk else . end)
  | map_values(. + {type:"stdio"})                              # Claude Code uses an explicit type
  # github: REMOTE hosted MCP — native http + PAT Bearer (no Docker / local runtime).
  # Only set when the token resolved non-empty so a fresh machine does not get a
  # broken "Bearer " entry baked in (dotfiles#15). A later apply fills it in.
  | (if $gh != "" then .github = {type:"http", url:"https://api.githubcopilot.com/mcp/",
               headers:{"Authorization": ("Bearer " + $gh)}} else . end)
  # outline: native http + a STATIC Bearer token (no OAuth/refresh tokens), baked.
  | (if $ot != "" then .outline = {type:"http", url:"https://outline.stump.rocks/mcp",
                headers:{"Authorization": ("Bearer " + $ot)}} else . end)
  # switchboard: native http + static Bearer (baked). Claude Code ONLY. Both halves
  # resolved above; only set when BOTH are non-empty so a fresh machine never bakes a
  # broken "Bearer " or a url-less entry (cf. github, dotfiles#15).
  | (if $sb != "" and $sburl != "" then .switchboard = {type:"http", url:$sburl,
                headers:{"Authorization": ("Bearer " + $sb)}} else . end)
  # cairn: native http + static Bearer (baked). Same both-halves rule as switchboard.
  | (if $cn != "" and $cnurl != "" then .cairn = {type:"http", url:$cnurl,
                headers:{"Authorization": ("Bearer " + $cn)}} else . end)
  # msgbrowse: local-only http mcp; darwin only (Claude Code is macOS-desktop-native).
  # No auth — localhost-only.
  | (if "{{ .chezmoi.os }}" == "darwin" then .msgbrowse = {type:"http", url:"{{ .msgbrowseMcpEndpoint }}"} else . end)
  # signal: thin JSON-RPC client launched via uv; paths resolved per-OS above.
  | .signal = {type:"stdio", command:$uv,
               args:["run","--directory",$sigdir,"signal-mcp","--account","{{ env "SIGNAL_MCP_ACCOUNT" | default .signalNumber }}","--operator","{{ env "SIGNAL_MCP_OPERATOR" | default .signalNumber }}","--transport","stdio"],
               env:{PATH:$sigpath}}
')"

mcp_merge "$CJ" "$desired"
