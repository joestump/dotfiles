# Repo-only files: present in the source repo, never applied to $HOME.
README.md
Architecture.md
CLAUDE.md
Makefile
docs/
examples/
scripts/
test/

# Oh My Zsh self-manages its own tree and self-updates it. chezmoi must manage
# ONLY ~/.oh-my-zsh/custom/. Use non-recursive '*' here: gitignore semantics
# forbid re-including children of a fully-excluded directory, so excluding
# '.oh-my-zsh/**' would also swallow custom/. Excluding only the direct children
# lets us re-include the custom/ dir below.
.oh-my-zsh/*
!.oh-my-zsh/custom/
# OMZ ships this example; leave it to OMZ, don't manage it.
.oh-my-zsh/custom/example.zsh
website/
dist/

# Vim runtime state — installed by vim-plug (~/.vim/plugged/) or created by vim
# itself (undo/backup/swap in ~/.local/state/vim/). chezmoi manages ~/.vimrc and
# the plug.vim external only.
.vim/plugged/
.vim/.netrwhist
.viminfo
.local/state/vim/

# OS-specific Vault Agent supervisor: launchd LaunchAgent on macOS, systemd
# --user service on Linux. Ignore the one that doesn't apply to this machine.
{{ if ne .chezmoi.os "darwin" -}}
Library/
{{ end -}}
{{ if ne .chezmoi.os "linux" -}}
.config/systemd/
{{ end -}}

# The scheduled harness sweeps are AGENT jobs: only a login carrying the
# `-agent` suffix (the bot half of the $USER / $USER-agent convention — see
# the Identity section of .chezmoidata.yaml, overridable via agentIdentity)
# gets the AGENT-ONLY sweep prompts. Human logins ignore those — the harness.d
# drop-ins that declare them carry the same gate, so they render with no
# [harness.*] table at all (comments only, which keeps the file — and so the
# harness.d directory — on disk for [server] harness_d).
#
# pr-sweep is deliberately NOT in this list: it is the one sweep that runs
# under BOTH identities, so its prompt must render on human logins too. Adding
# it back here would silently re-break Joe's half of the cross-identity review
# loop — the drop-in would declare a harness pointing at a prompt file that
# does not exist on that box.
{{ $sweepUser := .agentIdentity | default .chezmoi.username -}}
{{ if not (hasSuffix "-agent" $sweepUser) -}}
.config/dotfiles/stumpcloud-sweep.prompt.md
.config/dotfiles/issue-sweep.prompt.md
{{ end -}}
